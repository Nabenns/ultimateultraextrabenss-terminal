{
  "name": "ultimateultraextrabenss-terminal",
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/hub.js",
    "smoke": "npm run build && node dist/hub.js agents.smoke.json",
    "full": "npm run build && node dist/hub.js agents.config.json",
    "doctor": "npm run build && node scripts/doctor.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  }
}
